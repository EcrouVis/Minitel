1 VERSIONINFO 
FILEVERSION     ${CMAKE_PROJECT_VERSION_MAJOR},${CMAKE_PROJECT_VERSION_MINOR},${CMAKE_PROJECT_VERSION_PATCH},${CMAKE_PROJECT_VERSION_TWEAK}
PRODUCTVERSION  ${CMAKE_PROJECT_VERSION_MAJOR},${CMAKE_PROJECT_VERSION_MINOR},${CMAKE_PROJECT_VERSION_PATCH},${CMAKE_PROJECT_VERSION_TWEAK}
BEGIN
	BLOCK "StringFileInfo"
	BEGIN
		BLOCK "040C04E4"
		BEGIN
			VALUE "CompanyName", " "
			VALUE "FileDescription", "Minitel 12 Philips"
			VALUE "FileVersion", "${CMAKE_PROJECT_VERSION}"
			VALUE "InternalName","${CMAKE_PROJECT_NAME}"
			VALUE "LegalCopyright", "Yves Landemarre"
			VALUE "OriginalFilename","${CMAKE_PROJECT_NAME}${CMAKE_EXECUTABLE_SUFFIX}"
			VALUE "ProductName","${CMAKE_PROJECT_NAME}"
			VALUE "ProductVersion", "${CMAKE_PROJECT_VERSION}"
		END
	END
	BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x040C, 0x04E4
    END
END
M12_icon ICON "./M12_icon_square.ico"